NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI authentication
# Dev: uses `claude` CLI subprocess (subscription auth). No key needed.
# Prod: set to a console API key (sk-ant-api03-*).
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# FORCE_SDK=true  # uncomment to use SDK instead of CLI in dev

NEXT_PUBLIC_HAS_LOCAL_KEY=true
MODEL_AISLING=claude-sonnet-4-6
MODEL_LIGHT_ASSESSMENT=claude-haiku-4-5-20251001

# Transactional email (all optional — if none are set, the app no-ops on send).
# Set ONE of RESEND_API_KEY or MAILPACE_API_TOKEN to enable seller notifications
# on buyer inquiry. Resend takes precedence when both are present.
# RESEND_API_KEY=re_your_key_here
# MAILPACE_API_TOKEN=your_mailpace_server_token
# MAIL_FROM_ADDRESS must be a verified sender on whichever provider you chose.
# MAIL_FROM_ADDRESS=noreply@thefairies.ie
# Base URL used in inquiry emails for deep links back to the owner app.
# NEXT_PUBLIC_OWNER_ORIGIN=https://moving.thefairies.ie
