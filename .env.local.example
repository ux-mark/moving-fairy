NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI authentication
# Dev: uses `claude` CLI subprocess (subscription auth). No key needed.
# Prod: set to a console API key (sk-ant-api03-*).
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# FORCE_SDK=true  # uncomment to use SDK instead of CLI in dev

NEXT_PUBLIC_HAS_LOCAL_KEY=true
MODEL_AISLING=claude-sonnet-4-6
MODEL_LIGHT_ASSESSMENT=claude-haiku-4-5-20251001

# Transactional email (all optional — if none are set, the app no-ops on send).
# Resolution order: SMTP (if SMTP_HOST set) → Mailpace (if token set) → no-op.
# SMTP — preferred. Use the same creds you put into Supabase Auth's SMTP
# config (or any SMTP service you control). Bypasses Supabase, sends direct.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=         # leave blank; auto-true when SMTP_PORT=465
# Mailpace — fallback HTTP transactional. Set MAILPACE_API_TOKEN if no SMTP.
MAILPACE_API_TOKEN=
# From address — must be a verified sender on whichever provider you use.
MAIL_FROM_ADDRESS=noreply@thefairies.ie
NEXT_PUBLIC_OWNER_ORIGIN=https://moving.thefairies.ie
